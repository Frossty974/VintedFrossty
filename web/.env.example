# URL publique du site (SEO, sitemap, liens de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (authentification + base de données) ---
# Sans ces deux variables, l'espace membre fonctionne en "mode démo" (données stockées dans le navigateur).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur, utilisée uniquement par les routes API (formulaires). Ne jamais l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (phase 2 : paiements) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
